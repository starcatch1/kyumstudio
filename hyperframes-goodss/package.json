{
  "name": "hyperframes-goodss",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Stage 2B music-driven HyperFrames engine with external BGM analysis, beat/onset timing, narration ducking and audio mix QA on top of frozen Stage 2A",
  "scripts": {
    "extract": "node scripts/extract-looks.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "generate": "node scripts/generate-compositions.mjs",
    "config:set": "node scripts/set-config.mjs",
    "preset:smoke": "pwsh -File scripts/smoke-presets.ps1",
    "stage2a:validate": "node scripts/stage2a/validate-project.mjs project.json",
    "stage2a:test": "node scripts/stage2a/test-validation.mjs",
    "stage2a:generate": "node scripts/stage2a/generate-audio.mjs project.json && node scripts/stage2a/generate-project.mjs project.json",
    "stage2a:build": "pwsh -File run-stage2a.ps1 -ProjectFile project.json -Renderer auto",
    "stage2a:sample": "pwsh -File run-stage2a.ps1 -ProjectFile samples/non-character/project.json -Quality draft -Renderer fallback -NoOpen",
    "stage2b:validate": "node scripts/stage2b/prepare-assets.mjs samples/stage2b-music/project.json && node scripts/stage2b/validate-project.mjs samples/stage2b-music/project.json",
    "stage2b:music": "pwsh -File run-stage2b.ps1 -ProjectFile samples/stage2b-music/project.json -Quality draft -Renderer fallback -NoOpen",
    "stage2b:narration": "pwsh -File run-stage2b.ps1 -ProjectFile samples/stage2b-narration/project.json -Quality draft -Renderer fallback -NoOpen",
    "render:fallback:long": "node scripts/render-fallback.mjs projects/long/index.html style-long 30 1920 1080 renders/style-showcase-long-raw.mp4",
    "render:fallback:short": "node scripts/render-fallback.mjs projects/short/index.html style-short 17 1080 1920 renders/style-showcase-short-raw.mp4",
    "qa:long": "node scripts/qa-video.mjs renders/style-showcase-long-fixed.mp4 1920 1080 renders/qa-long.json",
    "qa:short": "node scripts/qa-video.mjs renders/style-showcase-short-fixed.mp4 1080 1920 renders/qa-short.json"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "playwright-core": "1.55.0"
  }
}
