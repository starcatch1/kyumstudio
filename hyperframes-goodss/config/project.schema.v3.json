{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyumstudio.local/hyperframes-goodss/project.schema.v3.json",
  "title": "hyperframes-goodss Stage 2B Project",
  "type": "object",
  "required": ["schemaVersion", "id", "assets", "compositions", "audio"],
  "properties": {
    "schemaVersion": {"const": 3},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "title": {"type": "string"},
    "quality": {"enum": ["draft", "standard", "high"]},
    "presets": {
      "type": "object",
      "properties": {
        "visual": {"type": "string"},
        "caption": {"type": "string"}
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["external", "silent"]},
        "bgm": {
          "type": "object",
          "properties": {
            "asset": {"type": "string"},
            "volume": {"type": "number", "minimum": 0, "maximum": 1},
            "loop": {"type": "boolean"},
            "start": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "beatSync": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "maxSnap": {"type": "number", "minimum": 0, "maximum": 1},
            "minSceneDuration": {"type": "number", "exclusiveMinimum": 0},
            "bpmMin": {"type": "number", "minimum": 40, "maximum": 240},
            "bpmMax": {"type": "number", "minimum": 40, "maximum": 240},
            "minConfidence": {"type": "number", "minimum": 0, "maximum": 1},
            "candidateSource": {"enum": ["beats", "onsets", "hybrid"]}
          },
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["none", "file", "tts"]},
            "asset": {"type": "string"},
            "script": {"type": "string"},
            "voice": {"type": "string"},
            "start": {"type": "number", "minimum": 0},
            "volume": {"type": "number", "minimum": 0, "maximum": 2},
            "captions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["start", "duration", "text"],
                "properties": {
                  "start": {"type": "number", "minimum": 0},
                  "duration": {"type": "number", "exclusiveMinimum": 0},
                  "text": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "ducking": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "ratio": {"type": "number", "minimum": 1, "maximum": 20},
            "attackMs": {"type": "number", "minimum": 1, "maximum": 2000},
            "releaseMs": {"type": "number", "minimum": 1, "maximum": 5000}
          },
          "additionalProperties": false
        },
        "normalization": {
          "type": "object",
          "properties": {
            "targetLufs": {"type": "number", "minimum": -30, "maximum": -5},
            "truePeak": {"type": "number", "minimum": -9, "maximum": 0},
            "lra": {"type": "number", "minimum": 1, "maximum": 30}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "preprocessors": {"type": "array", "items": {"type": "object"}},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "src"],
        "properties": {
          "type": {"enum": ["image", "video", "audio"]},
          "src": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "width", "height", "scenes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "fps": {"const": 30},
          "duration": {"oneOf": [{"const": "auto"}, {"type": "number", "exclusiveMinimum": 0}]},
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "duration"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["title", "media", "text", "end"]},
                "start": {"type": "number", "minimum": 0},
                "duration": {"type": "number", "exclusiveMinimum": 0},
                "track": {"type": "integer", "minimum": 0},
                "mediaTrack": {"type": "integer", "minimum": 0},
                "asset": {"type": "string"},
                "mediaStart": {"type": "number", "minimum": 0},
                "layout": {"enum": ["center", "split", "full"]},
                "motion": {"type": "string"},
                "snapEnd": {"type": "boolean"},
                "transition": {
                  "oneOf": [
                    {"enum": ["cut", "lime-wipe", "black-wipe", "center-split"]},
                    {
                      "type": "object",
                      "required": ["type"],
                      "properties": {
                        "type": {"enum": ["cut", "lime-wipe", "black-wipe", "center-split"]},
                        "duration": {"type": "number", "minimum": 0}
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "text": {"type": "object", "additionalProperties": true}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
