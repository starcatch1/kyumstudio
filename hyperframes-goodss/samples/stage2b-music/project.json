    "beatSync": {"enabled": true, "maxSnap": 0.26, "minSceneDuration": 1.5, "bpmMin": 80, "bpmMax": 160, "minConfidence": 0.10, "candidateSource": "beats"},
    "narration": {"mode": "none"},
